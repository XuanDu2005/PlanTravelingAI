# File .env riêng cho Docker compose.
# Load bằng docker compose -f docker/docker-compose.yml (cwd=./docker/).
# Ghi lai DATABASE_URL dung host "postgres" (service name trong compose)
# thay vi "localhost" vi container api truy cap postgres qua service name.

DATABASE_URL=postgresql://travelmind:travelmind@postgres:5432/travelmind?schema=public

NODE_ENV=production
PORT=3000

JWT_SECRET=dev-secret-please-change-in-production-environments
JWT_EXPIRES_IN=7d

CORS_ORIGINS=http://localhost:5173,http://localhost:4173

AI_PROVIDER=gemini
AI_API_KEY=replace-with-your-gcp-api-key
AI_MODEL=gemini-2.5-flash

OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:7b

VITE_API_BASE_URL=/api

SEED_ADMIN_EMAIL=admin@travelmind.local
SEED_ADMIN_PASSWORD=Admin@123456
SEED_ADMIN_NAME=Admin