# ---- Stage 1: build ----
FROM node:20-bookworm-slim AS builder
WORKDIR /app

# pnpm via Corepack (declared version is honored from packageManager)
RUN corepack enable

# Copy only what is needed to resolve the workspace first (cache-friendly)
COPY pnpm-workspace.yaml package.json pnpm-lock.yaml* ./
COPY apps/web/package.json apps/web/

# Install web + transitive deps. Allow fallback to non-frozen if the lockfile
# in the repo is missing or stale (the user can regen via `pnpm install`).
RUN pnpm install --filter @travelmind/web... \
    --prefer-offline \
    || pnpm install --filter @travelmind/web...

# Build-time public URL (Vite reads from VITE_* at build time)
ARG VITE_API_BASE_URL=/api
ENV VITE_API_BASE_URL=${VITE_API_BASE_URL}

# Now copy the rest of the web app source (tsconfig*.json + src + index.html)
COPY apps/web apps/web

WORKDIR /app/apps/web
# `--no-frozen-lockfile` here is safe; install already ran above.
RUN pnpm build

# ---- Stage 2: runtime ----
FROM nginx:1.27-alpine AS runner
COPY --from=builder /app/apps/web/dist /usr/share/nginx/html
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
