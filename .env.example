# ----------------------------------------
# TravelMind MVP - Environment variables
# Copy this file to `.env` and adjust values.
# ----------------------------------------

# ---- Database (PostgreSQL) ----
DATABASE_URL=postgresql://travelmind:travelmind@localhost:5432/travelmind?schema=public

# ---- Backend (NestJS) ----
NODE_ENV=development
PORT=3000

# JWT
JWT_SECRET=please-change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d

# CORS - comma separated origins allowed for the web client
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# ---- AI Provider ----
# Default: gemini (requires AI_API_KEY; falls back to mock if empty)
# Options: gemini | openai | mock
AI_PROVIDER=gemini
# Get a free Gemini key at https://aistudio.google.com/apikey
AI_API_KEY=
# Default: gemini-2.5-flash. Other options: gemini-2.5-pro, gemini-2.5-flash-lite
AI_MODEL=gemini-2.5-flash

# ---- Frontend (Vite) ----
# Exposed to the browser at build time - ONLY use public values here
VITE_API_BASE_URL=http://localhost:3000/api

# ---- Seed admin (used by prisma seed) ----
SEED_ADMIN_EMAIL=admin@travelmind.local
SEED_ADMIN_PASSWORD=Admin@123456
SEED_ADMIN_NAME=Admin
