# PostgreSQL used by Prisma in local development.
DATABASE_URL=postgresql://travelmind:travelmind@localhost:5432/travelmind?schema=public

# Authentication — replace this value outside local development.
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
PORT=3000
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# AI providers: mock works without network/API keys.
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL=gemini-2.5-flash
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# Optional seed admin.
SEED_ADMIN_EMAIL=admin@travelmind.local
SEED_ADMIN_PASSWORD=Admin@123456
SEED_ADMIN_NAME=Admin
SEED_ON_BOOT=true
